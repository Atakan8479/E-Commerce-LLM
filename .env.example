MSSQL_SA_PASSWORD=replace-with-existing-local-sa-password
REDIS_PASSWORD=replace-with-existing-local-redis-password

FLASHSALE_OPENAI_MODEL_ID=replace-with-chat-model-id
FLASHSALE_OPENAI_ENDPOINT=http://host.docker.internal:11434/v1
FLASHSALE_LLM_REQUEST_TIMEOUT_SECONDS=30
FLASHSALE_OPENAI_API_KEY=local-development-key

FLASHSALE_EMBEDDING_MODEL_ID=replace-with-embedding-model-id

FLASHSALE_REDIS_CONNECT_TIMEOUT_SECONDS=5
FLASHSALE_REDIS_OPERATION_TIMEOUT_SECONDS=5