{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "OutboxPublisher": {
    "BatchSize": 50,
    "PollingInterval": "00:00:05"
  },

  "Kafka": {
    "BootstrapServers": "localhost:19092",
    "StockDepletedTopic": "inventory.stock-depleted"
  },

  "AllowedHosts": "*"
}